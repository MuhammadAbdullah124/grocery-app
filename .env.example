# Base URL of the backend REST API (Laravel). Leave unset to use the built-in mock data layer.
EXPO_PUBLIC_API_BASE_URL=https://api.freshcart.example.com/api/v1

# Set to "true" to force the app to use the mock data layer even if EXPO_PUBLIC_API_BASE_URL is set.
EXPO_PUBLIC_USE_MOCK_API=true

# Simulated network latency (ms) for the mock API, useful for testing loading states.
EXPO_PUBLIC_MOCK_LATENCY_MS=500
